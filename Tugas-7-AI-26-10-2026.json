    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst today = new Date();\ntoday.setHours(23, 59, 59, 999);\n\nconst sevenDaysAgo = new Date(today);\nsevenDaysAgo.setDate(today.getDate() - 7);\nsevenDaysAgo.setHours(0, 0, 0, 0);\n\nlet formattedString = \"📊 Data pengeluaran saya 7 hari terakhir:\\n\\n\";\nlet hasExpenses = false;\n\nfor (const item of items) {\n  const row = item.json;\n  const rawDate = row['Tanggal'] || '';\n  \n  let expenseDate;\n\n  // Deteksi apakah formatnya ISO (dari n8n) atau Text (DD/MM/YYYY)\n  if (rawDate.includes('T')) {\n     // Format dari sistem otomatis (misal: 2026-10-19T00:00:00.000Z)\n     expenseDate = new Date(rawDate);\n  } else {\n     // Format manual text DD/MM/YYYY\n     const [day, month, year] = rawDate.split(\"/\").map(Number);\n     expenseDate = new Date(year, month - 1, day);\n  }\n\n  // Cek jika tanggalnya valid dan masuk rentang 7 hari\n  if (!isNaN(expenseDate.getTime()) && expenseDate >= sevenDaysAgo && expenseDate <= today) {\n    const kategori = row['Kategori'] || '-';\n    const deskripsi = row['Deskripsi'] || '-';\n    const metode = row['Metode Pembayaran'] || '-';\n    const penerima = row['Penerima'] || '-';\n    const jumlah = row['Jumlah (IDR)'] || '0'; // Perhatikan nama kolom persisnya\n    \n    formattedString += `- ${rawDate} | ${kategori}\\n`;\n    formattedString += `  ${deskripsi}\\n`;\n    formattedString += `  Metode: ${metode}\\n`;\n    formattedString += `  Penerima: ${penerima}\\n`;\n    formattedString += `  Rp${jumlah}\\n\\n`;\n    \n    hasExpenses = true;\n  }\n}\n\nreturn [{\n  json: {\n    hasExpenses: hasExpenses,\n    promptData: formattedString\n  }\n}];"
      },
