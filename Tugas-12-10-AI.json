    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = DateTime.now().setZone('Asia/Jakarta');\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const dateStr = row['Scheduled Date'];\n  const timeStr = row['Scheduled Time'];\n  const status = row['Status'];\n\n  if (status === 'Pending' && dateStr && timeStr) {\n    let scheduledTime;\n\n    // Deteksi format tanggal\n    if (typeof dateStr === 'string' && dateStr.includes('/')) {\n      // Format DD/MM/YYYY → konversi ke YYYY-MM-DD\n      const parts = dateStr.split('/');\n      const day = parts[0];\n      const month = parts[1];\n      const year = parts[2];\n      const isoDate = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;\n      scheduledTime = DateTime.fromISO(`${isoDate}T${timeStr}`, { zone: 'Asia/Jakarta' });\n    } else {\n      // Format YYYY-MM-DD\n      scheduledTime = DateTime.fromISO(`${dateStr}T${timeStr}`, { zone: 'Asia/Jakarta' });\n    }\n\n    if (scheduledTime.isValid && scheduledTime <= now) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;\n"
      },
