    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet positive = 0;\nlet negative = 0;\nlet neutral = 0;\n\nfor (const item of items) {\n  const sentiment = item.json.Sentiment;\n  if (sentiment === 'Positive') {\n    positive++;\n  } else if (sentiment === 'Negative') {\n    negative++;\n  } else if (sentiment === 'Neutral') {\n    neutral++;\n  }\n}\n\nconst total = items.length;\n\nreturn [{\n  json: {\n    total: total,\n    positive: positive,\n    negative: negative,\n    neutral: neutral,\n    positive_pct: total > 0 ? ((positive / total) * 100).toFixed(1) : 0,\n    negative_pct: total > 0 ? ((negative / total) * 100).toFixed(1) : 0,\n    neutral_pct: total > 0 ? ((neutral / total) * 100).toFixed(1) : 0\n  }\n}];"
      },
