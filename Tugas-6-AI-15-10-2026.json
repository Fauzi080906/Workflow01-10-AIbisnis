    {
      "parameters": {
        "jsCode": "// Ambil semua data dari Google Sheets\nconst items = $input.all();\n\nconsole.log('Total items:', items.length);\n\n// Validasi data\nif (!items || items.length === 0) {\n  throw new Error('Tidak ada data yang dibaca dari Google Sheets!');\n}\n\n// Kelompokkan data berdasarkan jam\nconst hourlyData = {};\n\nfor (const item of items) {\n  const row = item.json;\n  const hour = row['Jam Posting'];\n  const likes = parseInt(row['Likes']) || 0;\n  const comments = parseInt(row['Comments']) || 0;\n  const shares = parseInt(row['Shares']) || 0;\n  \n  // Hitung engagement score dengan bobot\n  // Likes x1, Comments x2, Shares x3\n  const engagement = likes + (comments * 2) + (shares * 3);\n  \n  if (!hourlyData[hour]) {\n    hourlyData[hour] = {\n      hour: hour,\n      totalEngagement: 0,\n      totalLikes: 0,\n      totalComments: 0,\n      totalShares: 0,\n      totalPosts: 0\n    };\n  }\n  \n  hourlyData[hour].totalEngagement += engagement;\n  hourlyData[hour].totalLikes += likes;\n  hourlyData[hour].totalComments += comments;\n  hourlyData[hour].totalShares += shares;\n  hourlyData[hour].totalPosts += 1;\n}\n\n// Hitung rata-rata dan susun hasil\nconst results = Object.values(hourlyData).map(h => ({\n  hour: h.hour,\n  avgEngagement: Math.round(h.totalEngagement / h.totalPosts),\n  avgLikes: Math.round(h.totalLikes / h.totalPosts),\n  avgComments: Math.round(h.totalComments / h.totalPosts),\n  avgShares: Math.round(h.totalShares / h.totalPosts),\n  totalPosts: h.totalPosts\n}));\n\n// Sort berdasarkan engagement tertinggi\nresults.sort((a, b) => b.avgEngagement - a.avgEngagement);\n\n// Ambil 10 teratas\nconst top10 = results.slice(0, 10);\n\n// Tambahkan label rekomendasi\nconst withLabels = top10.map((r, index) => ({\n  ...r,\n  rekomendasi: index < 3 ? 'SANGAT DIREKOMENDASIKAN' : \n               index < 5 ? 'DIREKOMENDASIKAN' : \n               'PERTIMBANGKAN'\n}));\n\nreturn withLabels.map(r => ({ json: r }));"
      },
