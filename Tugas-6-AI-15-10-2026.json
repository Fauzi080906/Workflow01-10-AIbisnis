    {
      "parameters": {
        "jsCode": "// Ambil data dari node \"Analisis Waktu Terbaik\" (bukan dari node Google Sheets)\nconst items = $('Analisis Waktu Terbaik').all();\n\nif (!items || items.length === 0) {\n  return [{ json: { message: '❌ Tidak ada data untuk dikirim' } }];\n}\n\n// Ambil top 5 jam terbaik\nconst top5 = items.slice(0, 5);\n\nlet message = `📊 *HASIL ANALISIS WAKTU POSTING TERBAIK*\\n\\n`;\nmessage += `🏆 *TOP 5 JAM TERBAIK:*\\n\\n`;\n\ntop5.forEach((item, index) => {\n  const data = item.json;\n  const medal = index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : '⭐';\n  \n  message += `${medal} *JAM ${data.hour}*\\n`;\n  message += `   📈 Avg Engagement: *${data.avgEngagement}*\\n`;\n  message += `   ❤️ Avg Likes: ${data.avgLikes}\\n`;\n  message += `   💬 Avg Comments: ${data.avgComments}\\n`;\n  message += `   🔄 Avg Shares: ${data.avgShares}\\n`;\n  message += `   📝 Total Post: ${data.totalPosts} post\\n`;\n  message += `   ⭐ ${data.rekomendasi}\\n\\n`;\n});\n\nmessage += `_Gunakan insight ini untuk meningkatkan engagement! 🚀_`;\n\nreturn [{ json: { message: message } }];"
      },
